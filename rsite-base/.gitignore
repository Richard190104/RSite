# CakePHP specific files #
##########################
/config/app_local.php
/config/.env
/logs/*
/tmp/*
/vendor/*

# CakePHP Migrations plugin's local schema cache — regenerated
# automatically on every `bin/cake migrations` run, reflects whatever DB
# this machine last talked to, not a shared/required project state.
/config/Migrations/schema-dump-*.lock

# Manual deploy script state (bin/deploy.mjs). .vendor-deployed-hash is
# tracked in git (not ignored) on purpose: it records the composer.lock
# hash of what's actually on the server, shared via main so anyone
# deploying sees the real state instead of a per-machine guess. Whoever
# deploys after a composer.lock change is responsible for committing the
# updated marker afterwards — see the comment in deploy.mjs.
/.deploy-build/
/.deploy-archive.tar
/.deploy-translations-build/
/.deploy-translations-archive.tar
/.translate-and-deploy-build/
/.translate-and-deploy-archive.tar
/.translate-and-deploy-worktree/

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Icon must end with two \r
Icon
ehthumbs.db
Thumbs.db
.directory

